{
  "kind": "collectionType",
  "collectionName": "progresses",
  "info": {
    "singularName": "progress",
    "pluralName": "progresses",
    "displayName": "Progress",
    "description": "Completed-lessons join: one row = a student completed a lesson. Per-course % is computed, never stored."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "completedAt": {
      "type": "datetime",
      "required": true
    },
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "progressEntries"
    },
    "lesson": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::lesson.lesson",
      "inversedBy": "progressEntries"
    }
  }
}
