{
  "kind": "collectionType",
  "collectionName": "quiz_attempts",
  "info": {
    "singularName": "quiz-attempt",
    "pluralName": "quiz-attempts",
    "displayName": "Quiz Attempt",
    "description": "One student's graded submission of one quiz. score is computed server-side at submit; multiple attempts allowed by default."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "score": {
      "type": "integer",
      "required": true
    },
    "totalQuestions": {
      "type": "integer"
    },
    "answers": {
      "type": "json",
      "required": true
    },
    "submittedAt": {
      "type": "datetime",
      "required": true
    },
    "student": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "quizAttempts"
    },
    "quiz": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quiz.quiz",
      "inversedBy": "attempts"
    }
  }
}
