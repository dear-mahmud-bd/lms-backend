{
  "kind": "collectionType",
  "collectionName": "questions",
  "info": {
    "singularName": "question",
    "pluralName": "questions",
    "displayName": "Question",
    "description": "An MCQ question in a quiz. correctAnswer is a 0-based index into options; never exposed to students in the taking route."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "prompt": {
      "type": "text",
      "required": true
    },
    "options": {
      "type": "json",
      "required": true
    },
    "correctAnswer": {
      "type": "integer",
      "required": true
    },
    "order": {
      "type": "integer"
    },
    "quiz": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::quiz.quiz",
      "inversedBy": "questions",
      "required": true
    }
  }
}
